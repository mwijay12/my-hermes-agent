# Mwijay AI — Mfano wa .env (USIWEKE KEYS HALISI KWENYE GITHUB!)
# Nakili faili hii kwenda .env ya Hermes yako na uweke keys zako:
#   Windows: %LOCALAPPDATA%\hermes\.env
#   Linux/WSL2: ~/.hermes/.env

# --- Gemini (Google AI Studio) — BURE ---
# Pata key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
# GOOGLE_API_KEY=your_gemini_key_here

# --- Groq — BURE, haraka sana ---
# Pata key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# --- OpenRouter — models 300+, free models pia ---
# Pata key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# --- Nous Portal (subscription moja: models + search + image + TTS) ---
# NOUS_API_KEY=your_nous_key_here

# --- Zinginezo (hiari) ---
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# KIMI_API_KEY=your_kimi_key_here
