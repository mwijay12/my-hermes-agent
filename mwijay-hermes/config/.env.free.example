# Mwijay AI — Funguo ZA BURE (free tiers) — mfano tu, usiweke keys halisi kwenye Git!
# Nakili mistari unayohitaji kwenye .env ya Hermes:
#   Windows: %LOCALAPPDATA%\hermes\.env
#   Linux/WSL2: ~/.hermes/.env
#
# Kisha jaribu:  python3 mwijay-hermes/scripts/check_free_keys.py

# ---------- NATIVE (Hermes inawatambua moja kwa moja) ----------

# Groq — bure, haraka sana (30 RPM / 14,400 RPD)
# https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA NIM — ~139 models bure (GLM, Nemotron, Qwen) — uthibitisho wa simu
# https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# OpenCode Zen / Go — 34 free models (big-pickle, deepseek-v4-flash-free, mimo-v2.5-free)
# https://opencode.ai/auth
OPENCODE_API_KEY=

# Kilo Code — 29 free models, 200 req/saa, hakuna kadi
# https://app.kilo.ai/profile
KILO_API_KEY=

# Google Gemini (AI Studio) — Flash, 1M context, hakuna kadi
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter — 37 models ":free" (+$10 topup → 1,000 req/siku)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Z AI / Zhipu (GLM) — 8 free models
# https://open.bigmodel.cn/usercenter/apikeys
ZAI_API_KEY=

# Hugging Face — router, ~$0.10/mwezi mikopo
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Nyinginezo za native (hiari)
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# MINIMAX_API_KEY=
# DASHSCOPE_API_KEY=      # Alibaba / Qwen

# ---------- CUSTOM (OpenAI-compatible; ongeza kwenye "providers:" ya config.yaml) ----------

# Inception (Mercury) — tokeni 100,000,000 bure mara moja, hakuna kadi
# https://platform.inceptionlabs.ai
INCEPTION_API_KEY=

# Agnes AI — mikopo ya bure, models Agnes / Echo / Pavo
# https://platform.agnes-ai.com/settings/apiKeys
AGNES_API_KEY=

# Cerebras — tokeni 1,000,000 kwa siku, 30 RPM, hakuna kadi
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# SambaNova — 20 RPM / 20 req-siku + $5 mikopo
# https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# GitHub Models — tumia GitHub PAT yako (permission: models:read)
# https://github.com/settings/tokens
GITHUB_TOKEN=

# LLM7.io — hata bila usajili (60 RPM / 250 req-saa)
# https://token.llm7.io
LLM7_API_KEY=

# Mistral La Plateforme — free tier (uthibitisho wa simu)
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ModelScope — 2,000 req/siku
# https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=

# SiliconFlow
# https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# Chutes.ai
# https://chutes.ai
CHUTES_API_KEY=

# Cohere (trial ~1,000 req/mwezi)
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
